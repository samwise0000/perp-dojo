# Copy this file to .env for local use. On Vercel, set the same names under
# Project → Settings → Environment Variables instead.

# A READ-ONLY Bybit API key: Account → API → Create New Key → System-generated → "Read-Only".
# The app refuses to work with a key that can trade or withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Password for the app's API. Required on Vercel; optional locally.
PERP_PASSWORD=

# Optional. Use https://api.bybit.eu, https://api.bybit.tr etc. for regional accounts.
BYBIT_BASE_URL=https://api.bybit.com

# Optional, locally only: the port to serve on.
PORT=8090

# Set automatically on Vercel when you connect a Blob store. Without it, "Save to
# server" writes to data/ locally and is disabled on Vercel.
# BLOB_READ_WRITE_TOKEN=
